	"localization"
	{
		"english"
		{
			"Title" "OpenXcom3D"
			"Description" "OpenXcom3D's first-person battlescape: left stick walks (WASD), the right trackpad looks (mouse), R2 fires, L2 cancels. L1 switches mouse look and the free cursor, R1 the isometric map and 3D. A jump, B reload, X fire mode, Y inventory; d-pad up/down flight and lifts, right next soldier, left switch hand (held: akimbo); left trackpad snap, aimed, auto, door (left/right held: snap turns); L4/R4 lean (setting Lean), L5 night vision (held: light), R5 end turn (held: flare); Menu classic HUD (held: 3D HUD)."
		}
	}
