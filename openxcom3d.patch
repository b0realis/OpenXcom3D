+	TextButton *flyGroup = flightOn(unit) ? _btnFly : nullptr;
+	TextButton *lightGroup = _save->getTogglePersonalLight() ? _btnLight : nullptr;
+	TextButton *nightGroup = _state->_map->isNightVisionOn() ? _btnNight : nullptr;
