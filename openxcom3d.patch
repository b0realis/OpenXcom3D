+/**
+ * Tells the map (the first-person view draws them) which pellets are in flight: this gun's and the
+ * other gun's.
+ */
+void ProjectileFlyBState::showPellets()
+{
+	std::vector<Projectile*> flying;
+	for (const auto *list : { &_pellets, &_partnerPellets })
+	{
+		for (const auto &pellet : *list) flying.push_back(pellet.first);
+	}
+	_parent->getMap()->setPellets(flying);
+}
+
+/**
+ * Forgets a gun's pellets (landed, or the shot over).
+ * @param pellets This gun's or the other gun's.
+ */
+void ProjectileFlyBState::dropPellets(std::vector<std::pair<Projectile*, int>> &pellets)
+{
+	for (const auto &pellet : pellets) delete pellet.first;
+	pellets.clear();
+	showPellets();
+}
+
+/**
+ * Dual wield as a volley (first-person view, "Akimbo volley"): the other gun fires its round at the same moment, with its
+ * own accuracy (cut as this one's, see FirstPerson::DualWieldAccuracy), ammo and sound; it flies beside this round (see think).
+ */
+void ProjectileFlyBState::createPartnerProjectile()
+{
+	BattleItem *partnerWeapon = _action.dualWeapon;
+	if (!partnerWeapon || _partnerShots <= 0 || _partner || _action.type == BA_THROW || _action.type == BA_LAUNCH)
+	{
+		return;
+	}
+	_partnerAction = _action;
+	_partnerAction.weapon = partnerWeapon;
+	_partnerAction.type = _action.dualType;
+	_partnerAction.dualWeapon = nullptr;
+	_partnerAmmo = partnerWeapon->getAmmoForAction(_partnerAction.type);
+	if (!_partnerAmmo || partnerWeapon->getArcingShot(_partnerAction.type))
+	{
+		_partnerShots = 0;
+		return;
+	}
+	Position target = _targetVoxel;
+	if (_partnerAction.freeAim)
+	{
+		FirstPerson::freeAimTarget(_parent->getSave()->getBattleState(), _partnerAction, target);
+	}
+	_partner = new Projectile(_parent->getMod(), _parent->getSave(), _partnerAction, _origin, target, _partnerAmmo);
+	const BattleActionAttack attack = BattleActionAttack::GetAferShoot(_partnerAction, _partnerAmmo);
+	const double divider = (_parent->getPanicHandled() ? 100.0 : 200.0) / FirstPerson::DualWieldAccuracy; // (together or in turn)
+	_partnerImpact = _partner->calculateTrajectory(BattleUnit::getFiringAccuracy(attack, _parent->getMod()) / divider);
+	if (_partnerImpact == V_EMPTY)
+	{
+		delete _partner; // no line of fire for it
+		_partner = nullptr;
+		return;
+	}
+	// a shotgun in the other hand: its pellets fly beside it too (first-person view, "Shotgun pellets
+	// in flight"); otherwise they're traced as it lands (see partnerHit)
+	_partnerPelletsFly = false;
+	if (_partnerAmmo->getRules()->getShotgunPellets() != 0 && _partnerAmmo->getRules()->getDamageType()->isDirect()
+		&& FirstPerson::pelletsInFlight(_parent->getSave()->getBattleState()))
+	{
+		_partnerPelletsFly = true;
+		tracePellets(_partnerAction, _partnerAmmo, target, *_partner, _partnerPellets);
+		showPellets();
+	}
+	const int sound = _partnerAmmo->getRules()->getFireSound() != Mod::NO_SOUND ? _partnerAmmo->getRules()->getFireSound() : partnerWeapon->getRules()->getFireSound();
+	if (sound != Mod::NO_SOUND)
+	{
+		_parent->getMod()->getSoundByDepth(_parent->getDepth(), sound)->play(-1, _parent->getMap()->getSoundAngle(_partner->getOrigin()));
+	}
+	if (!_partnerPaid)
+	{
+		// its time units, now that it fires (none if this shot never got off, or it had no line of fire):
+		// the rest of the pair's cost
+		_partnerCharge.spendTU();
+		_partnerPaid = true;
+	}
+	partnerWeapon->spendAmmoForAction(_partnerAction.type, _parent->getSave());
+	_unit->getStatistics()->shotsFiredCounter++;
+	--_partnerShots;
+	_parent->getMap()->setPartnerProjectile(_partner);
+}
+
+/**
+ * Dual wield: the other gun's round lands with this one, like a shotgun's extra pellet (its
+ * hit and puff go in with this round's; an explosive one, or one with no hit of this round to
+ * go with, gets its own explosion), and a shotgun's own pellets with it.
+ */
+void ProjectileFlyBState::partnerHit()
+{
+	if (!_partner)
+	{
+		return;
+	}
+	_partner->skipTrajectory();
+	if (_partnerImpact != V_OUTOFBOUNDS)
+	{
+		const BattleActionAttack attack = BattleActionAttack::GetAferShoot(_partnerAction, _partnerAmmo);
+		const RuleItem *ammoRules = _partnerAmmo->getRules();
+		const bool explosive = ammoRules->getExplosionRadius(attack) != 0 || !ammoRules->getDamageType()->isDirect();
+		const int offset = explosive && _partnerImpact != V_UNIT ? -2 : 0;
+		const Position at = _partner->getPosition(offset);
+		if (explosive || !_hitQueued)
+		{
+			_parent->statePushFront(new ExplosionBState(_parent, _partner->getLastPositions(offset), attack, 0, false, _partner->getDistance()));
+		}
+		else
+		{
+			if (!_partnerHitShown) // (shown already when it landed first, see partnerStops)
+			{
+				_parent->getMap()->getExplosions()->push_back(new Explosion(at, ammoRules->getHitAnimation(), 0, false, false, ammoRules->getHitAnimationFrames()));
+				if (ammoRules->getHitSound() != Mod::NO_SOUND)
+				{
+					_parent->getMod()->getSoundByDepth(_parent->getDepth(), ammoRules->getHitSound())->play(-1, _parent->getMap()->getSoundAngle(at.toTile()));
+				}
+			}
+			const int power = (_partnerAction.weapon->getRules()->getIgnoreAmmoPower() ? _partnerAction.weapon->getRules()->getPowerBonus(attack) : ammoRules->getPowerBonus(attack)) - ammoRules->getPowerRangeReduction(_partner->getDistance());
+			_parent->getSave()->getTileEngine()->hit(attack, at, power, ammoRules->getDamageType());
+		}
+		if (_partnerImpact == V_UNIT)
+		{
+			// the hit counted for the other gun
+			std::swap(_action, _partnerAction);
+			std::swap(_ammo, _partnerAmmo);
+			projectileHitUnit(at);
+			std::swap(_action, _partnerAction);
+			std::swap(_ammo, _partnerAmmo);
+		}
+		// a shotgun in the other hand: its pellets land with it, those that flew beside it or traced
+		// now as the game traces a shotgun's (a player's report: it fired single slugs); counted for
+		// the other gun, and its experience as nerfed as this gun's pellets' (see think)
+		if (ammoRules->getShotgunPellets() != 0 && ammoRules->getDamageType()->isDirect())
+		{
+			if (!_partnerPelletsFly)
+			{
+				tracePellets(_partnerAction, _partnerAmmo, _partner->getTarget(), *_partner, _partnerPellets);
+			}
+			std::swap(_action, _partnerAction);
+			std::swap(_ammo, _partnerAmmo);
+			_unit->rememberXP();
+			for (const auto &pellet : _partnerPellets)
+			{
+				pelletLands(pellet.first, pellet.second, attack, 0);
+			}
+			_unit->nerfXP();
+			std::swap(_action, _partnerAction);
+			std::swap(_ammo, _partnerAmmo);
+		}
+	}
+	dropPellets(_partnerPellets);
+	_parent->getMap()->setPartnerProjectile(nullptr);
+	delete _partner;
+	_partner = nullptr;
+	_partnerStopped = _partnerHitShown = false;
+}
+
+/**
+ * Dual wield as a volley: the other gun's round has reached its end before this gun's (a faster
+ * round, a shorter path: a player's report, it hung there "floating, waiting for the second
+ * bullet to hit before the hit animation"). Its hit shows at once: no longer drawn (the
+ * first-person view marks where it ended), the game's hit animation (played on here, see think,
+ * until this round lands and the explosion state takes it over) and its sound; its damage still
+ * goes in with this round's hit, as the volley's does (see partnerHit). An explosive round, whose
+ * blast is its hit, and one with no hit of this round to go with (it left the map) wait for it.
+ */
+void ProjectileFlyBState::partnerStops()
+{
+	_partnerStopped = true;
+	const RuleItem *ammoRules = _partnerAmmo->getRules();
+	const BattleActionAttack attack = BattleActionAttack::GetAferShoot(_partnerAction, _partnerAmmo);
+	if (ammoRules->getExplosionRadius(attack) != 0 || !ammoRules->getDamageType()->isDirect() || _projectileImpact == V_OUTOFBOUNDS)
+	{
+		return;
+	}
+	_parent->getMap()->setPartnerProjectile(nullptr);
+	_partnerHitShown = true;
+	if (_partnerImpact == V_OUTOFBOUNDS)
+	{
+		return; // (out of the map: nothing to show)
+	}
+	_partnerEarlyHit = new Explosion(_partner->getPosition(0), ammoRules->getHitAnimation(), 0, false, false, ammoRules->getHitAnimationFrames());
+	_parent->getMap()->getExplosions()->push_back(_partnerEarlyHit);
+	if (ammoRules->getHitSound() != Mod::NO_SOUND)
+	{
+		_parent->getMod()->getSoundByDepth(_parent->getDepth(), ammoRules->getHitSound())->play(-1, _parent->getMap()->getSoundAngle(_partner->getPosition(0).toTile()));
+	}
+}
