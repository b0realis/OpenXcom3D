+void ProjectileFlyBState::takeTurn(int gun)
+{
+	_turnGuns[_turnGun].fired = _action.autoShotCounter;
+	_turnGun = gun;
+	_action.weapon = _turnGuns[gun].weapon;
+	_action.type = _turnGuns[gun].type;
+	_action.autoShotCounter = _turnGuns[gun].fired;
+	_ammo = _action.weapon->getAmmoForAction(_action.type);
+	if (gun == 1 && !_partnerPaid)
+	{
+		_partnerCharge.spendTU();
+		_partnerPaid = true;
+	}
