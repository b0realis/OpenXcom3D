+/**
+ * Captures the mouse (hidden cursor + input grab = relative motion in SDL 1.2) while
+ * the top state wants it, e.g. for first-person mouse look, and gives it back with the
+ * cursor in the middle of the window as soon as another state is on top.
+ * @param capture Should the mouse be captured?
+ */
+void Game::updateMouseCapture(bool capture)
+{
+	if (capture == _mouseCaptured)
+	{
+		return;
+	}
+	_mouseCaptured = capture;
+	if (capture)
+	{
+		_cursor->setHidden(true);
+		SDL_ShowCursor(SDL_DISABLE);
+		SDL_WM_GrabInput(SDL_GRAB_ON);
+	}
+	else
+	{
+		SDL_WM_GrabInput(Options::captureMouse);
+		SDL_ShowCursor(SDL_ENABLE);
+		const SDL_Surface *video = SDL_GetVideoSurface();
+		if (video)
+		{
+			SDL_WarpMouse(video->w / 2, video->h / 2);
+		}
+		_cursor->setHidden(false);
+	}
+}
+
