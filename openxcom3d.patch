+/**
+ * Packs a distance into a stereo angle: angles stay below DistanceStep (the map's own ones are
+ * 280..440), so a multiple of it can carry the distance through code that passes only an angle.
+ * @param angle Stereo angle, 0..359.
+ * @param distance 0 (near) to 255 (far), as for Mix_SetPosition.
+ */
+int Sound::packDistance(int angle, int distance)
+{
+	return ((angle % 360) + 360) % 360 + DistanceStep * (1 + std::clamp(distance, 0, 255));
+}
+
 void Sound::play(int channel, int angle, int distance) const
  {
+	if (angle >= DistanceStep)
+	{
+		// an angle with a distance packed in (see packDistance)
+		distance = std::max(distance, angle / DistanceStep - 1);
+		angle %= DistanceStep;
+	}
 	if (!Options::mute && _sound)
  	{
 		int chan = Mix_PlayChannel(channel, _sound.get(), 0);
