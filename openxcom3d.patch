+	_partnerAction.type = _action.dualType;
+	_partnerAction.dualWeapon = nullptr;
+	_partnerAmmo = partnerWeapon->getAmmoForAction(_partnerAction.type);
+	if (!_partnerAmmo || partnerWeapon->getArcingShot(_partnerAction.type))
+	{
+		_partnerShots = 0;
+		return;
+	}
+	Position target = _targetVoxel;
+	if (_partnerAction.freeAim)
+	{
+		FirstPerson::freeAimTarget(_parent->getSave()->getBattleState(), _partnerAction, target);
+	}
+	_partner = new Projectile(_parent->getMod(), _parent->getSave(), _partnerAction, _origin, target, _partnerAmmo);
+	const BattleActionAttack attack = BattleActionAttack::GetAferShoot(_partnerAction, _partnerAmmo);
+	const double divider = (_parent->getPanicHandled() ? 100.0 : 200.0) * 2.0;
+	_partnerImpact = _partner->calculateTrajectory(BattleUnit::getFiringAccuracy(attack, _parent->getMod()) / divider);
+	if (_partnerImpact == V_EMPTY)
+	{
+		delete _partner; // no line of fire for it
+		_partner = nullptr;
+		return;
+	}
+	const int sound = _partnerAmmo->getRules()->getFireSound() != Mod::NO_SOUND ? _partnerAmmo->getRules()->getFireSound() : partnerWeapon->getRules()->getFireSound();
+	if (sound != Mod::NO_SOUND)
+	{
+		_parent->getMod()->getSoundByDepth(_parent->getDepth(), sound)->play(-1, _parent->getMap()->getSoundAngle(_partner->getOrigin()));
+	}
+	if (!_partnerPaid)
