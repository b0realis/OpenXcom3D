diff --git a/src/FirstPerson/FirstPersonParticles.cpp b/src/FirstPerson/FirstPersonParticles.cpp
new file mode 100644
index 000000000..25c0f68af
--- /dev/null
+++ b/src/FirstPerson/FirstPersonParticles.cpp
@@ -0,0 +1,112 @@
+/*
+ * Copyright 2010-2026 OpenXcom Developers.
+ *
