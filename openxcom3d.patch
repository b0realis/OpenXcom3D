+void ProjectileFlyBState::createPartnerProjectile()
+{
+	BattleItem *partnerWeapon = _action.dualWeapon;
+	if (!partnerWeapon || _partnerShots <= 0 || _partner || _action.type == BA_THROW || _action.type == BA_LAUNCH)
+	{
