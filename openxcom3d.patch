+/**
+ * Dual wield taking turns: which gun fires the next round: the other one than the last round's
+ * (the chosen gun first), or the same one again when the other has no rounds left, so each fires
+ * its own mode's full burst (a player's report: a 4-round and a 5-round gun fired 4 and 1; now
+ * A B A B A B A B B). A gun is done when its mode's rounds are fired or it's out of ammo.
+ * @return The gun (0 the chosen one, 1 the other), or -1 when neither has a round left.
+ */
+int ProjectileFlyBState::nextTurnGun() const
+{
+	const bool started = _action.autoShotCounter > 0 || _turnGuns[0].fired > 0 || _turnGuns[1].fired > 0;
+	const int order[2] = { started ? 1 - _turnGun : 0, started ? _turnGun : 1 };
+	for (int gun : order)
+	{
+		const TurnGun &turnGun = _turnGuns[gun];
+		const int fired = gun == _turnGun ? _action.autoShotCounter : turnGun.fired; // (the gun firing now counts in the action)
+		const BattleItem *ammo = static_cast<const BattleItem*>(turnGun.weapon)->getAmmoForAction(turnGun.type);
+		if (ammo && ammo->getAmmoQuantity() != 0 && turnGun.weapon->haveNextShotsForAction(turnGun.type, fired))
+		{
+			return gun;
+		}
+	}
+	return -1;
+}
