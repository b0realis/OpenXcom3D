--- /dev/null
+++ b/app/src/main/java/org/openxcom/extended/VrActivity.java
@@ -0,0 +1,196 @@
+package org.openxcom.extended;
+
+import org.libsdl.app.SDLActivity;
+
+import android.app.Activity;
+import android.app.PendingIntent;
+import android.content.Intent;
+import android.os.Build;
+import android.os.Bundle;
+import android.util.Log;
+import android.view.KeyEvent;
+import android.view.WindowManager;
+
+/*
+ * OpenXcom3D: VR mode's immersive activity on the Meta Quest (a "hybrid app": the game is the
+ * panel, OpenXcom, and this activity only lives while the 3D view is in the headset).
+ *
+ * The game itself runs on in the panel's thread (SDL's) the whole time. This activity gives the
+ * headset's OpenXR runtime an immersive activity to show the 3D view from: its native side
+ * (src/FirstPerson/FirstPersonXrSession.cpp in the engine) makes the OpenXR session on a thread
+ * of its own when this activity is created, and ends it when it goes. Leaving the 3D view (F8,
+ * the B button) asks Horizon OS for the panel again (returnToPanel) and finishes this activity.
+ */
+public class VrActivity extends Activity {
+
+	/** The log tag, the game's own (adb logcat -s OpenXcom3D). */
+	static final String TAG = "OpenXcom3D";
+
+	/** The activity now, for the calls from native (null while there's none). */
+	private static volatile VrActivity sCurrent = null;
+
+	/** The native side was started for this activity (the game asked for VR). */
+	private boolean mNativeStarted = false;
+
+	/**
+	 * Created (the panel started it): the screen kept on, and the native side starts the OpenXR
+	 * session with this activity. Without a game asking for VR (the system bringing this activity
+	 * back on its own, in a new process), it just goes.
+	 */
+	@Override
+	protected void onCreate(Bundle savedInstanceState) {
+		super.onCreate(savedInstanceState);
+		if (!OpenXcom.isVrPlaying()) {
+			Log.w(TAG, "VR activity: no game asked for it, leaving");
+			finish();
+			return;
+		}
+		sCurrent = this;
+		getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+		Log.i(TAG, "VR activity: created");
+		mNativeStarted = true;
+		nativeOnCreate(this);
+	}
+
+	/** Resumed: logged (the OpenXR session follows from the runtime's own events). */
+	@Override
+	protected void onResume() {
+		super.onResume();
+		if (mNativeStarted) {
+			nativeOnLifecycle("resumed");
+		}
+	}
+
+	/** Paused (the headset taken off, the system's menu...): logged. */
+	@Override
+	protected void onPause() {
+		if (mNativeStarted) {
+			nativeOnLifecycle("paused");
+		}
+		super.onPause();
+	}
+
+	/** The window's focus (the system's menu over it): logged. */
+	@Override
+	public void onWindowFocusChanged(boolean hasFocus) {
+		super.onWindowFocusChanged(hasFocus);
+		if (mNativeStarted) {
+			nativeOnLifecycle(hasFocus ? "focused" : "unfocused");
+		}
+	}
+
+	/** Going: the native side ends the OpenXR session and its thread first. */
+	@Override
+	protected void onDestroy() {
+		Log.i(TAG, "VR activity: destroyed");
+		if (mNativeStarted) {
+			mNativeStarted = false;
+			nativeOnDestroy(this);
+		}
+		if (sCurrent == this) {
+			sCurrent = null;
+		}
+		super.onDestroy();
+	}
+
+	/**
+	 * Keys (a Bluetooth keyboard) go to the game as on the panel (SDL's own path, so the game sees
+	 * a keyboard); the volume keys stay the system's. The controllers' buttons come through OpenXR.
+	 */
+	@Override
+	public boolean dispatchKeyEvent(KeyEvent event) {
+		final int keyCode = event.getKeyCode();
+		if (keyCode == KeyEvent.KEYCODE_VOLUME_UP || keyCode == KeyEvent.KEYCODE_VOLUME_DOWN || keyCode == KeyEvent.KEYCODE_VOLUME_MUTE) {
+			return super.dispatchKeyEvent(event);
+		}
+		if (event.getAction() == KeyEvent.ACTION_DOWN) {
+			SDLActivity.onNativeKeyDown(keyCode);
+			return true;
+		}
+		if (event.getAction() == KeyEvent.ACTION_UP) {
+			SDLActivity.onNativeKeyUp(keyCode);
+			return true;
+		}
+		return super.dispatchKeyEvent(event);
+	}
+
+	/** Back doesn't close VR (B is read through OpenXR, and leaves the 3D view in the game). */
+	@Override
+	public void onBackPressed() {
+	}
+
+	/**
+	 * Called from native (the game's thread) once the 3D view was left and the OpenXR session has
+	 * ended: back to the panel, and this activity goes.
+	 */
+	public static void returnToPanel() {
+		final VrActivity activity = sCurrent;
+		if (activity == null) {
+			Log.w(TAG, "VR: no immersive activity to leave");
+			return;
+		}
+		activity.runOnUiThread(new Runnable() {
+			@Override
+			public void run() {
+				activity.leaveToPanel();
+			}
+		});
+	}
+
+	/** Called when the game itself ends during VR: this activity just goes. */
+	public static void finishImmersive() {
+		final VrActivity activity = sCurrent;
+		if (activity == null) {
+			return;
+		}
+		activity.runOnUiThread(new Runnable() {
+			@Override
+			public void run() {
+				activity.finish();
+			}
+		});
+	}
+
+	/**
+	 * Back to the panel: on the Meta Quest by Horizon OS's way for hybrid apps (Home, with the
+	 * panel to open once Home is up: the intent extra "extra_launch_in_home_pending_intent"),
+	 * elsewhere straight; the panel is the game's own activity, brought to the front (not a new
+	 * one). Then this activity finishes.
+	 */
+	private void leaveToPanel() {
+		Intent panel = new Intent(this, OpenXcom.class);
+		panel.setAction(Intent.ACTION_MAIN);
+		panel.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP);
+		try {
+			if (isMetaHeadset()) {
+				PendingIntent pendingPanel = PendingIntent.getActivity(this, 0, panel,
+						PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+				Intent home = new Intent(Intent.ACTION_MAIN);
+				home.addCategory(Intent.CATEGORY_HOME);
+				home.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+				home.putExtra("extra_launch_in_home_pending_intent", pendingPanel);
+				Log.i(TAG, "VR: back to the panel through Home");
+				startActivity(home);
+			} else {
+				Log.i(TAG, "VR: back to the panel");
+				startActivity(panel);
+			}
+		} catch (Exception e) {
+			Log.e(TAG, "VR: couldn't ask for the panel: " + e);
+		}
+		finish();
+	}
+
+	/** Is this a Meta headset (Horizon OS)? */
+	private static boolean isMetaHeadset() {
+		return "Oculus".equalsIgnoreCase(Build.MANUFACTURER) || "Meta".equalsIgnoreCase(Build.MANUFACTURER);
+	}
+
+	/**
+	 * The native side: the activity created (start the OpenXR session), its moments, and its end
+	 * (this activity's session only: an older activity's end may come after a newer one began).
+	 */
+	private static native void nativeOnCreate(Activity activity);
+	private static native void nativeOnLifecycle(String what);
+	private static native void nativeOnDestroy(Activity activity);
+}
