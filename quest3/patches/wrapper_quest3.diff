diff --git a/app/src/main/jni/deps_cmake/git_version.cmake b/app/src/main/jni/deps_cmake/git_version.cmake
new file mode 100644
index 0000000..4405468
--- /dev/null
+++ b/app/src/main/jni/deps_cmake/git_version.cmake
@@ -0,0 +1,16 @@
+# OpenXcom3D: writes git_version.h (the game's version line) with the engine tree's commit, run at
+# every build by the oxce_git_version target (see ../CMakeLists.txt). configure_file rewrites the
+# header only when the commit changed, so nothing is recompiled for nothing; and the commit isn't a
+# CMake argument any more, which made the Gradle plugin start a new build folder for every commit.
+# Run as: cmake -DOXCE_DIR=<engine tree> -DOUTPUT=<header> -P git_version.cmake
+execute_process(
+    COMMAND git rev-parse --short=7 HEAD
+    WORKING_DIRECTORY "${OXCE_DIR}"
+    OUTPUT_VARIABLE OPENXCOM_VERSION_STRING
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    RESULT_VARIABLE git_result
+    ERROR_QUIET)
+if(NOT git_result EQUAL 0 OR OPENXCOM_VERSION_STRING STREQUAL "")
+    set(OPENXCOM_VERSION_STRING "unknown")
+endif()
+configure_file("${OXCE_DIR}/src/git_version.h.in" "${OUTPUT}")
