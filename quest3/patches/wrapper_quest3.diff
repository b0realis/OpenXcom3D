+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+/*
+ * ALTERED SOURCE (OpenXcom3D, 2026-11-06): SDL 2.0.9's src/video/android/SDL_androidevents.c
+ * (Meridian's SDL fork, b1d96c5), built in its place (see ../deps_cmake/sdl.cmake), so that the
+ * game can play on while its panel is in the background: the Meta Quest's VR mode shows the
+ * game in an immersive activity of its own, and the panel's activity (SDL's) is paused behind it.
+ *
+ * - Blocking the game while paused is chosen at every pump by the hint
+ *   SDL_ANDROID_BLOCK_ON_PAUSE (as SDL 2.0.10 has it; 2.0.9 had it fixed at compile time, on):
+ *   on (the default) as before; off, the game runs on.
+ * - With it off, pausing the sound is chosen by SDL_ANDROID_BLOCK_ON_PAUSE_PAUSEAUDIO (as SDL
+ *   2.0.14 has it; on by default): off, the sound plays on too.
+ * - The GL context is backed up only when one is current, so a second backup (the hint switched
+ *   while paused) can't lose it.
+ * - The GL context is restored for real: SDL's note of what is current is cleared first. (A
+ *   renderer call while the surface was gone, the game running on, leaves "current" noted with
+ *   nothing current in EGL; SDL_GL_MakeCurrent then thought the restore already done, and the
+ *   next swap went to a surface with no context.)
+ *
+ * Both code paths are otherwise 2.0.9's own.
+ */
+#include "../SDL/src/SDL_internal.h"
+
+#if SDL_VIDEO_DRIVER_ANDROID
+
+#include "../SDL/src/video/android/SDL_androidevents.h"
+#include "SDL_events.h"
+#include "SDL_hints.h"
+#include "../SDL/src/video/android/SDL_androidkeyboard.h"
+#include "../SDL/src/video/android/SDL_androidwindow.h"
+
+/* OpenXcom3D: the hints (SDL 2.0.10's and 2.0.14's names; 2.0.9's SDL_hints.h has neither) */
+#ifndef SDL_HINT_ANDROID_BLOCK_ON_PAUSE
+#define SDL_HINT_ANDROID_BLOCK_ON_PAUSE "SDL_ANDROID_BLOCK_ON_PAUSE"
+#endif
+#ifndef SDL_HINT_ANDROID_BLOCK_ON_PAUSE_PAUSEAUDIO
+#define SDL_HINT_ANDROID_BLOCK_ON_PAUSE_PAUSEAUDIO "SDL_ANDROID_BLOCK_ON_PAUSE_PAUSEAUDIO"
+#endif
+
+/* Can't include sysaudio "../../audio/android/SDL_androidaudio.h"
+ * because of THIS redefinition */
+
+#if !SDL_AUDIO_DISABLED && SDL_AUDIO_DRIVER_ANDROID
+extern void ANDROIDAUDIO_ResumeDevices(void);
+extern void ANDROIDAUDIO_PauseDevices(void);
+#else
+static void ANDROIDAUDIO_ResumeDevices(void) {}
+static void ANDROIDAUDIO_PauseDevices(void) {}
+#endif
+
+#if !SDL_AUDIO_DISABLED && SDL_AUDIO_DRIVER_OPENSLES
+extern void openslES_ResumeDevices(void);
+extern void openslES_PauseDevices(void);
+#else
+static void openslES_ResumeDevices(void) {}
+static void openslES_PauseDevices(void) {}
+#endif
+
+/* OpenXcom3D: the non-blocking pause paused the sound (so its resume resumes it) */
+static int nonBlockingAudioPaused = 0;
+
+/* Number of 'type' events in the event queue */
+static int
+SDL_NumberOfEvents(Uint32 type)
+{
+    return SDL_PeepEvents(NULL, 0, SDL_PEEKEVENT, type, type);
+}
+
+static void
+android_egl_context_restore(SDL_Window *window)
+{
+    if (window) {
+        SDL_Event event;
+        SDL_WindowData *data = (SDL_WindowData *) window->driverdata;
+        /* OpenXcom3D: nothing current first, so the context below is made current in EGL for real */
+        SDL_GL_MakeCurrent(window, NULL);
+        if (SDL_GL_MakeCurrent(window, (SDL_GLContext) data->egl_context) < 0) {
+            /* The context is no longer valid, create a new one */
+            data->egl_context = (EGLContext) SDL_GL_CreateContext(window);
+            SDL_GL_MakeCurrent(window, (SDL_GLContext) data->egl_context);
+            event.type = SDL_RENDER_DEVICE_RESET;
+            SDL_PushEvent(&event);
+        }
+    }
+}
+
+static void
+android_egl_context_backup(SDL_Window *window)
+{
+    if (window) {
+        /* Keep a copy of the EGL Context so we can try to restore it when we resume */
+        SDL_WindowData *data = (SDL_WindowData *) window->driverdata;
+        /* OpenXcom3D: only a context that is current (a second backup would keep "none") */
+        SDL_GLContext current = SDL_GL_GetCurrentContext();
+        if (current) {
+            data->egl_context = current;
+        }
+        /* We need to do this so the EGLSurface can be freed */
+        SDL_GL_MakeCurrent(window, NULL);
+    }
+}
+
+
+/*
+ * Android_ResumeSem and Android_PauseSem are signaled from Java_org_libsdl_app_SDLActivity_nativePause and Java_org_libsdl_app_SDLActivity_nativeResume
+ * When the pause semaphore is signaled, if SDL_ANDROID_BLOCK_ON_PAUSE is defined the event loop will block until the resume signal is emitted.
+ *
+ * No polling necessary
+ */
+
+static void
+Android_PumpEvents_Blocking(_THIS)
+{
+    SDL_VideoData *videodata = (SDL_VideoData *)_this->driverdata;
+
+    if (videodata->isPaused) {
+
+        /* Make sure this is the last thing we do before pausing */
+        SDL_LockMutex(Android_ActivityMutex);
+        android_egl_context_backup(Android_Window);
+        SDL_UnlockMutex(Android_ActivityMutex);
+
+        ANDROIDAUDIO_PauseDevices();
+        openslES_PauseDevices();
+
+        if (SDL_SemWait(Android_ResumeSem) == 0) {
+
+            videodata->isPaused = 0;
+
+            ANDROIDAUDIO_ResumeDevices();
+            openslES_ResumeDevices();
+
+            /* Restore the GL Context from here, as this operation is thread dependent */
+            if (!SDL_HasEvent(SDL_QUIT)) {
+                SDL_LockMutex(Android_ActivityMutex);
+                android_egl_context_restore(Android_Window);
+                SDL_UnlockMutex(Android_ActivityMutex);
+            }
+
+            /* Make sure SW Keyboard is restored when an app becomes foreground */
+            if (SDL_IsTextInputActive()) {
+                Android_StartTextInput(_this); /* Only showTextInput */
+            }
+        }
+    } else {
+        if (videodata->isPausing || SDL_SemTryWait(Android_PauseSem) == 0) {
+            /* We've been signaled to pause (potentially several times), but before we block ourselves,
+             * we need to make sure that the very last event (of the first pause sequence, if several)
+             * has reached the app */
+            if (SDL_NumberOfEvents(SDL_APP_DIDENTERBACKGROUND) > SDL_SemValue(Android_PauseSem)) {
+                videodata->isPausing = 1;
+            }
+            else {
+                videodata->isPausing = 0;
+                videodata->isPaused = 1;
+            }
+        }
+    }
+}
+
+static void
+Android_PumpEvents_NonBlocking(_THIS)
+{
+    SDL_VideoData *videodata = (SDL_VideoData *)_this->driverdata;
+
+    if (videodata->isPaused) {
+        if (SDL_SemTryWait(Android_ResumeSem) == 0) {
+
+            videodata->isPaused = 0;
+
+            /* OpenXcom3D: the sound back only if this pause paused it */
+            if (nonBlockingAudioPaused) {
+                nonBlockingAudioPaused = 0;
+                ANDROIDAUDIO_ResumeDevices();
+                openslES_ResumeDevices();
+            }
+
+            /* Restore the GL Context from here, as this operation is thread dependent */
+            if (!SDL_HasEvent(SDL_QUIT)) {
+                SDL_LockMutex(Android_ActivityMutex);
+                android_egl_context_restore(Android_Window);
+                SDL_UnlockMutex(Android_ActivityMutex);
+            }
+
+            /* Make sure SW Keyboard is restored when an app becomes foreground */
+            if (SDL_IsTextInputActive()) {
+                Android_StartTextInput(_this); /* Only showTextInput */
+            }
+        }
+    } else {
+        if (SDL_SemTryWait(Android_PauseSem) == 0) {
+
+            SDL_LockMutex(Android_ActivityMutex);
+            android_egl_context_backup(Android_Window);
+            SDL_UnlockMutex(Android_ActivityMutex);
+
+            /* OpenXcom3D: the sound paused only if the hint says so (on by default) */
+            if (SDL_GetHintBoolean(SDL_HINT_ANDROID_BLOCK_ON_PAUSE_PAUSEAUDIO, SDL_TRUE)) {
+                nonBlockingAudioPaused = 1;
+                ANDROIDAUDIO_PauseDevices();
+                openslES_PauseDevices();
+            }
+
+            videodata->isPaused = 1;
+        }
+    }
+}
+
+/* OpenXcom3D: blocking or not, chosen at every pump (see the top of this file) */
+void
+Android_PumpEvents(_THIS)
+{
+    if (SDL_GetHintBoolean(SDL_HINT_ANDROID_BLOCK_ON_PAUSE, SDL_TRUE)) {
+        Android_PumpEvents_Blocking(_this);
+    } else {
+        Android_PumpEvents_NonBlocking(_this);
+    }
+}
+
+#endif /* SDL_VIDEO_DRIVER_ANDROID */
+
