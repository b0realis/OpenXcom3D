# Switches on the engine's first-person mode (src/FirstPerson) and styles its interface.
firstPerson:
  enabled: true
  maxViewDistance: 60   # tiles
  combatMusic: [GMDEFEND, GMDEFBAS] # tense tracks while aliens are in sight (UFO, TFTD)
  # Night vision in 3D (with the "Night vision needs gear" setting): wearing one of these armors
  # or carrying one of these items gives the NIGHT VISION button. Units that see as far in the
  # dark as by day (aliens, and armors with visibilityAtDark) always have it.
  nightVision:
    - STR_POWER_SUIT_UC          # UFO: alien-alloy helmets with elerium-powered optics
    - STR_FLYING_SUIT_UC
    - HOVERTANK_ARMOR            # UFO: alien sensor suite
    - STR_ION_ARMOR_UC           # TFTD
    - STR_MAGNETIC_ION_ARMOR_UC
    - DISPLACER_ARMOR            # TFTD: the alien-tech submersible
  # The original games' windows are openings in the walls' voxel shapes, so the 3D view sees
  # through them as the game does, and none are listed here. A mod whose terrain draws glass
  # panes on solid walls can list them: per terrain data set, the window records (record numbers
  # in its MCD) and the sprite colours that are glass. The 3D view then sees through those voxels
  # (tinted; bullets still hit them), inside the panes only. For example:
  #   windows:
  #     - dataSet: MYTOWN
  #       records: [12, 13]
  #       glassColors: [148, 149, 150, 151]
  # Weather particles by terrain data set (only where the sky is open above).
  weather:
    - dataSet: POLAR
      type: snow
    - dataSet: JUNGLE
      type: rain
    - dataSet: DESERT
      type: dust
    - dataSet: MARS
      type: dust
  # The helmet cameras' bad signal, by mission (alien deployment) type: 1 a glitch now and then
  # (any mission not listed), 2 a lot (the aliens' own ground, where their machinery jams the
  # feed), 0 none. A later entry (or a later mod's) overrides.
  # Underground maps: the 3D view finds a map's surface from its outer ring of tiles by itself
  # (levels whose ring is rock are underground: rock beyond the edges below the surface, and a
  # map underground all the way up, like a base or an alien colony's inside, gets rock over it
  # instead of the sky or the water). A mission it gets wrong can be listed here as underground
  # all the way up. Never list a map that starts on the surface and goes on underground, nor a
  # name two games share for different maps (TFTD's seabed colony is STR_ALIEN_BASE_ASSAULT,
  # like UFO's alien base).
  undergroundMissions: []
  badSignal:
    # UFO: Mars (both stages), an alien base, a base defence; TFTD: an alien colony (both
    # stages), T'leth (all three), an artefact site (both), a base defence
    - missions: [STR_MARS_CYDONIA_LANDING, STR_MARS_THE_FINAL_ASSAULT, STR_ALIEN_BASE_ASSAULT, STR_BASE_DEFENSE, STR_ALIEN_COLONY_P2, STR_TLETH_P1, STR_TLETH_P2, STR_TLETH_P3, STR_ARTIFACT_SITE_P1, STR_ARTIFACT_SITE_P2]
      level: 2
  # The item table: what the 3D view isn't left to work out, by item type (as the mods name
  # them; types no loaded mod has are ignored). An item not listed, or a setting left out, is
  # worked out from the item's rules and picture:
  #   held: plate    a flat piece one voxel thick (worked out for a melee weapon that isn't
  #                  blunt and whose picture is thin: swords, knives, axes)
  #   held: cushion  rounded, thickest in the middle (worked out for everything else)
  #   shot: object   flies as an object, with no powder: no muzzle flash, and a white streak
  #                  unless it carries fire, acid or a shock (worked out for weapons aimed with
  #                  the throwing skill and not the firing skill, as the big mods' bows, and for
  #                  guns firing an arrow picture drawn mostly for those, as their crossbows)
  #   shot: powder   a gun's round, with a muzzle flash (worked out for every other gun)
  # A later entry (or a later mod's) overrides what it sets.
  items:
    # XPiratez: wide blades (too broad in their pictures to be worked out as blades)
    - types: [STR_BUTCHER_CLEAVER, STR_BANE_BLADE, STR_AX, STR_BLOOD_AX, STR_STONE_AX, STR_AQUA_HATCHET, STR_THUNDER_SICKLE, STR_SWORD]
      held: plate
    # XPiratez: gloves, claws, a noose and a garland of teeth (thin, but no blades)
    - types: [STR_FISTY, STR_CAT_PAWS, STR_GAUNTLET_CLAW, STR_BLACK_CAT, STR_NEKO_CLAWS, STR_PRED_CLAWS, STR_NOOSE, STR_SHARK_GARLAND]
      held: cushion
    # XPiratez: the harpoon guns, the dart pistol and the air musket (gas and air, no powder),
    # and the crossbows
    - types: [STR_HARPOON, STR_HARPOON_AUTO, STR_HARPOON_CARBINE, STR_DART_PISTOL, STR_AIR_MUSKET, STR_XBOW, STR_XBOW_CORAL, STR_EXECUTIONER_XBOW, STR_BALLISTA]
      shot: object

interfaces:
  - type: firstPerson
    elements:
      - id: button        # top bar buttons: Iso/3D, HUD, inventory, squad
        color: 240        # battlescape palette grey-blue ramp (240-255)
        color2: 128       # label colour, same as the soldier name on the original HUD
      - id: panel         # info panel behind name and stats
        color: 15
        border: 244
      - id: doom          # "DOOM MODE" marker on the panel
        color: 32
      - id: weapon        # weapon in hand on the panel
        color: 144
      - id: crosshairText # fire mode and shot info under the crosshair (recoloured live)
        color: 144
      - id: banner        # "hidden movement" during the alien turn
        color: 144
